DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-only-key-for-pet-shelter

# Битрикс24. Оставьте пустым до подключения портала.
# Полный URL поля «Вебхук для вызова REST API», до имени метода.
BITRIX24_WEBHOOK_URL=
# entityTypeId в crm.type.list и ID приюта в Django.
BITRIX24_ENTITY_TYPE_ID=
BITRIX24_SHELTER_ID=
# Коды полей из crm.item.fields. species обязательно, остальные по необходимости.
BITRIX24_FIELDS='{}'
# Сопоставления нужны для полей CRM типа «Список», которые возвращают ID.
BITRIX24_SPECIES_MAP='{}'
BITRIX24_GENDER_MAP='{}'
# Значения stageId для пристроенных питомцев, через запятую.
BITRIX24_ADOPTED_STAGE_IDS=

# ИИ-помощник. Ключ хранится только в серверном .env.
OPENROUTER_TOKEN=
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# OPENROUTER_VISION_MODEL=deepseek/deepseek-v4.1-flash-1017

# Укажите пути общей папки при серверном запуске.
# DJANGO_SQLITE_PATH=/srv/petshelter-nika/shared/db.sqlite3
# DJANGO_MEDIA_ROOT=/srv/petshelter-nika/shared/media
# DJANGO_ALLOWED_HOSTS=nika.romanenko-coding.ru
